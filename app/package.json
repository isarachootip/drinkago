{
  "name": "drinkgo-api",
  "version": "0.1.0",
  "description": "Drink&Go: ระบบขายน้ำผ่าน LINE + Delivery (backend)",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node -r ts-node/register src/main.ts",
    "db:generate": "node node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node -r ts-node/register src/db/migrate.ts",
    "db:seed": "node -r ts-node/register src/db/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "node node_modules/jest/bin/jest.js --runInBand",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/throttler": "^6.7.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "private": true,
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts"
    ],
    "testTimeout": 30000
  },
  "scriptsComment": "เรียก node ตรงๆ แทนคำสั่งใน node_modules/.bin เพราะ npm บน Windows ทำงานผิดเมื่อชื่อโฟลเดอร์มีเครื่องหมาย &"
}
