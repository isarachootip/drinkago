# คัดลอกเป็น .env แล้วแก้ค่า (ไฟล์ .env ไม่ถูกเก็บใน git)
PORT=3000
DATABASE_URL=postgres://drinkgo:drinkgo@localhost:5433/drinkgo

# dev = ทดสอบด้วย header x-dev-user (ห้ามใช้ใน production)
# line = ใช้ LINE ID token จริง ต้องตั้งค่า LINE_LOGIN_CHANNEL_ID
AUTH_MODE=dev

# จาก LINE Developers Console (Channel: ilife_login และ Messaging API)
LINE_LOGIN_CHANNEL_ID=2012276679
LINE_LOGIN_CHANNEL_SECRET=
LINE_LIFF_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

REQUIRE_DELIVERY_OTP=true
NOTIFY_DISPATCH_INTERVAL_MS=3000

# ตั้งค่าบัญชีรับโอนเงิน PromptPay QR Code ต้นแบบ
PROMPTPAY_ID=0636395619
PROMPTPAY_ACCOUNT_NAME=อิศระ ชูทิพย์
