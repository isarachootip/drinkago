# คัดลอกเป็น .env.production บน VPS แล้วแก้ค่า (ห้าม commit ไฟล์จริง)

# โดเมนที่ชี้มาที่ IP ของ VPS ถ้ายังไม่มีโดเมน ใช้ <IP แบบขีด>.sslip.io เช่น 203-0-113-10.sslip.io
DOMAIN=api.example.com

# รหัสผ่านฐานข้อมูล: สร้างด้วย  openssl rand -hex 24
DB_PASSWORD=

PORT=3000

# ระหว่างยังไม่มีบัญชี LINE ใช้ dev ได้ แต่ต้องตั้ง DEV_AUTH_KEY และส่ง header x-dev-key ทุกคำขอ
# สร้างด้วย  openssl rand -hex 32
AUTH_MODE=dev
DEV_AUTH_KEY=

# เมื่อมีบัญชี LINE แล้ว: เปลี่ยนเป็น AUTH_MODE=line และลบ DEV_AUTH_KEY
LINE_LOGIN_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

REQUIRE_DELIVERY_OTP=true
NOTIFY_DISPATCH_INTERVAL_MS=3000
